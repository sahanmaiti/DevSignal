# Virtual environment — never commit this
venv/
.venv/
env/

# Secrets — NEVER commit this
.env

# ─── Sensitive runtime data (BUG-5 fix) ──────────────────────────────────────
# Hunter.io cache contains real recruiter names, emails, and LinkedIn URLs.
# Committing this is a GDPR/CCPA violation.
.hunter_cache.json

# Any other local caches that may contain PII
*.cache.json

# Python bytecode cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# VS Code settings
.vscode/
*.code-workspace

# Logs
*.log
logs/

# Database files (if we ever use SQLite locally for testing)
*.db
*.sqlite3

# Distribution / packaging
dist/
build/
*.egg-info/

# Streamlit secrets
.streamlit/secrets.toml

# Playwright debug output
wellfound_debug.html