# ── Database ────────────────────────────────────────────────────────────────
# Local Docker Postgres — matches docker-compose.yml port mapping (5433:5432)
DATABASE_URL=postgresql://radar:radar_pass@localhost:5433/devsignal

# Optional — Neon cloud Postgres for the public dashboard sync (db_sync.py)
NEON_DATABASE_URL=

# ── Redis (ARQ job queue + /stats cache) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Pipeline API key (REQUIRED — api/main.py raises RuntimeError without it) ─
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PIPELINE_API_KEY=

# ── JWT auth ──────────────────────────────────────────────────────────────
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random secret is generated at process startup — fine for
# local dev, but every restart invalidates existing tokens. Set a fixed
# value for anything beyond local single-session testing.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# ── App environment ───────────────────────────────────────────────────────
# "development" or "production"
APP_ENV=development

# Required when APP_ENV=production — comma-separated list, no wildcard
# ALLOWED_ORIGINS=https://app.devsignal.com,https://dashboard.devsignal.com

# ── AI scoring (Groq — free tier) ────────────────────────────────────────────
GROQ_API_KEY=

# ── Recruiter enrichment ─────────────────────────────────────────────────────
HUNTER_API_KEY=
SERPER_API_KEY=

# ── Additional job-board scrapers (optional) ─────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Telegram notifications ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
